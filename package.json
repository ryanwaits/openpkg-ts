{
  "name": "openpkg-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:spec && bun run build:ui && bun run build:sdk && bun run build:cli && bun run build:react && bun run build:adapters",
    "build:spec": "cd packages/spec && bun run build",
    "build:sdk": "cd packages/sdk && bun run build",
    "build:ui": "cd packages/ui && bun run build",
    "build:cli": "cd packages/cli && bun run build",
    "build:react": "cd packages/react && bun run build",
    "build:adapters": "cd packages/adapters && bun run build",
    "lint": "bunx biome check packages/",
    "lint:fix": "bunx biome check --write packages/",
    "format": "bunx biome format --write packages/",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "NPM_TOKEN=$NPM_DOCCOV_TOKEN changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@changesets/cli": "^2.29.7",
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bunup": "^0.11.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "zod": "^4.3.5"
  }
}
