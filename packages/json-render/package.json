{
  "name": "@openpkg-ts/json-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    }
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "lint": "bunx biome check src/",
    "format": "bunx biome format --write src/"
  },
  "dependencies": {
    "@json-render/codegen": "0.4.0",
    "@json-render/core": "^0.4.0",
    "@json-render/react": "^0.4.0",
    "@openpkg-ts/sdk": "workspace:*",
    "@openpkg-ts/spec": "workspace:*",
    "@openpkg-ts/registry": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ai": ">=4",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
