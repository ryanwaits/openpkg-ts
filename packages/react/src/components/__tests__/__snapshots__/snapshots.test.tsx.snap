exports[`Component Snapshots MethodSection renders basic method section 1`] = `"<section id="createUser" data-section="createUser" class="openpkg-method-section mb-20 last:mb-0"><h2 class="text-2xl font-semibold tracking-tight text-[var(--openpkg-text-primary,#ededed)] mb-4">createUser</h2><code class="block font-mono text-sm text-[var(--openpkg-text-muted,#666666)] mb-6">createUser(name: string, email: string): Promise&lt;User&gt;</code><div class="openpkg-method-description text-[15px] leading-relaxed text-[var(--openpkg-text-secondary,#a0a0a0)] mb-6 [&amp;_a]:text-[var(--openpkg-accent-link,#6cb6ff)] [&amp;_a]:no-underline [&amp;_a]:font-medium hover:[&amp;_a]:underline [&amp;_code]:bg-[var(--openpkg-bg-badge,#262626)] [&amp;_code]:px-1.5 [&amp;_code]:py-0.5 [&amp;_code]:rounded [&amp;_code]:font-mono [&amp;_code]:text-[13px]"><p>Creates a new user with the specified name and email.</p></div><ul class="openpkg-method-notes list-disc list-inside text-[15px] leading-relaxed text-[var(--openpkg-text-secondary,#a0a0a0)] mb-8 space-y-2"><li>This is an async function</li><li>Returns a Promise</li></ul><div class="openpkg-method-params"><h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--openpkg-text-muted,#666666)] mb-4 pb-2 border-b border-[var(--openpkg-border-subtle,#262626)]">Parameters</h3><div>Parameters go here</div></div></section>"`;

