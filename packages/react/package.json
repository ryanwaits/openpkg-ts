{
  "name": "@openpkg-ts/react",
  "version": "0.3.0",
  "description": "React components for OpenPkg specs",
  "keywords": [
    "openpkg",
    "react",
    "components",
    "typescript",
    "api-docs"
  ],
  "homepage": "https://github.com/ryanwaits/openpkg-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanwaits/openpkg-ts.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Ryan Waits",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styled": {
      "import": "./dist/styled.js",
      "types": "./dist/styled.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openpkg-ts/spec": "^0.33.0",
    "@openpkg-ts/sdk": "^0.34.0",
    "@openpkg-ts/ui": "^0.1.4",
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "bunup": "latest",
    "happy-dom": "^20.3.7",
    "jsdom": "^27.4.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
