{
  "name": "@openpkg-ts/sdk",
  "version": "0.46.0",
  "description": "TypeScript API extraction SDK - programmatic primitives for OpenPkg specs",
  "keywords": [
    "openpkg",
    "typescript",
    "api-extractor",
    "sdk",
    "type-extraction"
  ],
  "homepage": "https://github.com/ryanwaits/openpkg-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanwaits/openpkg-ts.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Ryan Waits",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@openpkg-ts/spec": "^0.46.0",
    "picomatch": "4.0.3",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "shiki": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/picomatch": "4.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bunup": "^0.16.20",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
