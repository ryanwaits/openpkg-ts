{
  "name": "@openpkg-ts/ui",
  "version": "0.2.0",
  "description": "UI primitives and components for OpenPkg documentation",
  "homepage": "https://github.com/ryanwaits/openpkg-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanwaits/openpkg-ts.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js"
    },
    "./docskit": {
      "types": "./dist/docskit/index.d.ts",
      "import": "./dist/docskit/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/docskit.css": "./src/styles/docskit.css"
  },
  "scripts": {
    "build": "bunup",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "codehike": "^1.0.7",
    "lucide-react": "^0.555.0",
    "seti-icons": "^0.0.4",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bunup": "^0.16.20",
    "typescript": "^5.0.0"
  }
}
